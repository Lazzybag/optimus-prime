# GitHub Personal Access Token (PAT)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo:status, public_repo, read:repo_hook
# Note: Keep this file private and never commit it to version control
GITHUB_PAT=your_github_pat_token_here

# Optional: API Configuration
# DEFILLLAMA_API_TIMEOUT=30
# GITHUB_API_TIMEOUT=30

# Optional: Output Configuration
# CSV_OUTPUT_FILE=liquid_staking_analysis.csv
# JSON_OUTPUT_FILE=liquid_staking_analysis.json
